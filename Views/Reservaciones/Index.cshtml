@model IEnumerable<HotelSysRD.Models.Reservacion>

@{
    ViewData["Title"] = "Reservaciones";
}

<h1 class="mb-4 text-danger fw-bold">Reservaciones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nueva reservación</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay reservaciones registradas todavía.
    </div>
}
else
{
    <table class="table table-bordered table-hover table-striped align-middle">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Habitación</th>
                <th>Fecha Entrada</th>
                <th>Fecha Salida</th>
                <th>Estado</th>
                <th>Precio/Noche</th>
                <th>Noches</th>
                <th>Total</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reservacion in Model)
            {
                <tr>
                    <td>@reservacion.Cliente?.Nombre @reservacion.Cliente?.Apellido</td>
                    <td>@reservacion.Habitacion?.Numero - @reservacion.Habitacion?.Tipo</td>
                    <td>@reservacion.FechaEntrada.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@reservacion.FechaSalida.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@reservacion.PrecioPorNoche.ToString("C")</td>
                    <td>@reservacion.CantidadNoches</td>
                    <td>@reservacion.TotalAPagar.ToString("C")</td>
                    <td>@reservacion.Estado</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@reservacion.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@reservacion.Id" class="btn btn-sm btn-info">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@reservacion.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}