@model HotelSysRD.Models.Reservacion

@{
    ViewData["Title"] = "Detalle de Reservación";
}

<h1>Detalle de Reservación</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@Model.Cliente?.Nombre @Model.Cliente?.Apellido</dd>

        <dt class="col-sm-3">Habitación</dt>
        <dd class="col-sm-9">@Model.Habitacion?.Numero - @Model.Habitacion?.Tipo</dd>

        <dt class="col-sm-3">Fecha Entrada</dt>
        <dd class="col-sm-9">@Model.FechaEntrada.ToShortDateString()</dd>

        <dt class="col-sm-3">Fecha Salida</dt>
        <dd class="col-sm-9">@Model.FechaSalida.ToShortDateString()</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@Model.Estado</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>