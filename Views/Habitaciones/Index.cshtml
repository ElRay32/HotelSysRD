@model IEnumerable<HotelSysRD.Models.Habitacion>

@{
    ViewData["Title"] = "Habitaciones";
}

<h1>Habitaciones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Habitación</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Número</th>
            <th>Tipo</th>
            <th>Precio por Noche</th>
            <th>Estado</th>
            <th>Capacidad</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var habitacion in Model)
        {
            <tr>
                <td>@habitacion.Numero</td>
                <td>@habitacion.Tipo</td>
                <td>@habitacion.PrecioPorNoche</td>
                <td>@habitacion.Estado</td>
                <td>@habitacion.Capacidad</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@habitacion.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@habitacion.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@habitacion.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>